 "LIFE": [
  {
   "d": "note",
   "t": "the Node app starts listening on 443",
   "cs": "CLOSED",
   "ss": "LISTEN",
   "x": "kade-api's Node app opens a socket and listens. The laptop has no connection yet."
  },
  {
   "d": "r",
   "t": "SYN · SEQ = x",
   "cs": "SYN-SENT",
   "x": "The browser asks the OS to connect. The OS sends SYN and waits in SYN-SENT."
  },
  {
   "d": "l",
   "t": "SYN-ACK · SEQ = y, ACK = x+1",
   "ss": "SYN-RECEIVED",
   "x": "kade-api answers and waits for the last handshake message."
  },
  {
   "d": "r",
   "t": "ACK",
   "cs": "ESTABLISHED",
   "ss": "ESTABLISHED",
   "x": "Both sides are ESTABLISHED. About one round trip (~41 ms) has passed."
  },
  {
   "d": "r",
   "t": "data · HTTP request",
   "c": "purple",
   "x": "The request (after TLS, not shown) goes out as data segments."
  },
  {
   "d": "l",
   "t": "data + ACK · HTTP response",
   "c": "purple",
   "x": "The response segments also carry kade-api's ACK for the request (piggybacking)."
  },
  {
   "d": "r",
   "t": "ACK",
   "c": "green",
   "x": "The laptop confirms the response."
  },
  {
   "d": "r",
   "t": "FIN",
   "cs": "FIN-WAIT-1",
   "x": "The browser is done and closes. The laptop sends FIN."
  },
  {
   "d": "l",
   "t": "ACK",
   "c": "green",
   "cs": "FIN-WAIT-2",
   "ss": "CLOSE-WAIT",
   "x": "kade-api confirms. It is now in CLOSE-WAIT until its app calls close(). If the app never does, the connection stays here forever: a leak."
  },
  {
   "d": "l",
   "t": "FIN",
   "ss": "LAST-ACK",
   "x": "kade-api's app closes its side. FIN sent, waiting for the final ACK."
  },
  {
   "d": "r",
   "t": "ACK",
   "c": "green",
   "cs": "TIME-WAIT",
   "ss": "CLOSED",
   "x": "kade-api is done. The laptop enters TIME-WAIT, in case this ACK was lost."
  },
  {
   "d": "note",
   "t": "60 seconds later",
   "cs": "CLOSED",
   "x": "The laptop forgets the connection. Its port 52814 can be reused."
  }
 ],
 "SIMS": {
  "normal": {
   "n": "Normal (delayed, cumulative ACKs)",
   "rows": [
    {
     "d": "r",
     "t": "SEQ 4001 · 100 bytes"
    },
    {
     "d": "r",
     "t": "SEQ 4101 · 100 bytes"
    },
    {
     "d": "l",
     "t": "ACK 4201",
     "c": "green",
     "s": "one ACK covers both segments"
    },
    {
     "d": "r",
     "t": "SEQ 4201 · 100 bytes"
    },
    {
     "d": "r",
     "t": "SEQ 4301 · 100 bytes"
    },
    {
     "d": "l",
     "t": "ACK 4401",
     "c": "green"
    },
    {
     "d": "r",
     "t": "SEQ 4401 · 100 bytes"
    },
    {
     "d": "l",
     "t": "ACK 4501 (after a short delay)",
     "c": "green",
     "s": "all 500 bytes confirmed"
    }
   ],
   "x": "The receiver ACKs every second segment. Each ACK is cumulative: ACK 4201 confirms bytes 4001–4200 at once. 5 segments, only 3 ACKs."
  },
  "mid": {
   "n": "Lose segment 2",
   "rows": [
    {
     "d": "r",
     "t": "SEQ 4001 · 100 bytes"
    },
    {
     "d": "l",
     "t": "ACK 4101",
     "c": "green"
    },
    {
     "d": "r",
     "t": "SEQ 4101 · 100 bytes",
     "lost": true,
     "s": "lost"
    },
    {
     "d": "r",
     "t": "SEQ 4201"
    },
    {
     "d": "l",
     "t": "ACK 4101 · duplicate 1",
     "c": "yellow"
    },
    {
     "d": "r",
     "t": "SEQ 4301"
    },
    {
     "d": "l",
     "t": "ACK 4101 · duplicate 2",
     "c": "yellow"
    },
    {
     "d": "r",
     "t": "SEQ 4401"
    },
    {
     "d": "l",
     "t": "ACK 4101 · duplicate 3",
     "c": "yellow"
    },
    {
     "d": "r",
     "t": "SEQ 4101 · resent (fast retransmit)",
     "c": "blue"
    },
    {
     "d": "l",
     "t": "ACK 4501",
     "c": "green",
     "s": "jumps straight to the end"
    }
   ],
   "x": "Segments 3–5 arrive but byte 4101 is missing, so every ACK still asks for 4101. After 3 duplicate ACKs, the laptop resends just that segment without waiting for a timer. The receiver had kept 3–5 in its buffer, so one ACK 4501 now confirms everything."
  },
  "last": {
   "n": "Lose the last segment",
   "rows": [
    {
     "d": "r",
     "t": "SEQ 4001"
    },
    {
     "d": "r",
     "t": "SEQ 4101"
    },
    {
     "d": "l",
     "t": "ACK 4201",
     "c": "green"
    },
    {
     "d": "r",
     "t": "SEQ 4201"
    },
    {
     "d": "r",
     "t": "SEQ 4301"
    },
    {
     "d": "l",
     "t": "ACK 4401",
     "c": "green"
    },
    {
     "d": "r",
     "t": "SEQ 4401 · 100 bytes",
     "lost": true,
     "s": "lost"
    },
    {
     "d": "note",
     "t": "… no ACK for 4401, and nothing after it to cause duplicates …"
    },
    {
     "d": "note",
     "t": "retransmission timer runs out (RTO ≥ 200 ms)"
    },
    {
     "d": "r",
     "t": "SEQ 4401 · resent after timeout",
     "c": "blue"
    },
    {
     "d": "l",
     "t": "ACK 4501",
     "c": "green"
    }
   ],
   "x": "Nothing follows the lost segment, so there are no duplicate ACKs. The laptop waits for its retransmission timer, much longer than a round trip, then resends. Tail losses like this are the slowest kind to recover."
  },
  "ack": {
   "n": "Lose an ACK",
   "rows": [
    {
     "d": "r",
     "t": "SEQ 4001"
    },
    {
     "d": "r",
     "t": "SEQ 4101"
    },
    {
     "d": "l",
     "t": "ACK 4201",
     "c": "green",
     "lost": true,
     "s": "lost"
    },
    {
     "d": "r",
     "t": "SEQ 4201"
    },
    {
     "d": "r",
     "t": "SEQ 4301"
    },
    {
     "d": "l",
     "t": "ACK 4401",
     "c": "green",
     "s": "covers 4001–4400, including what the lost ACK confirmed"
    },
    {
     "d": "r",
     "t": "SEQ 4401"
    },
    {
     "d": "l",
     "t": "ACK 4501",
     "c": "green"
    }
   ],
   "x": "Because ACKs are cumulative, a lost ACK usually costs nothing: the next ACK confirms everything the lost one would have. Nothing is resent."
  }
 },
