{
 "SEQSETS": {
  "handshake": [
   "Laptop :52814",
   "kade-api :443",
   [
    {
     "d": "note",
     "t": "kade-api's Node app is waiting",
     "ss": "LISTEN"
    },
    {
     "d": "r",
     "t": "SYN · SEQ = x",
     "cs": "SYN-SENT"
    },
    {
     "d": "l",
     "t": "SYN-ACK · SEQ = y, ACK = x + 1",
     "ss": "SYN-RECEIVED"
    },
    {
     "d": "r",
     "t": "ACK · SEQ = x + 1, ACK = y + 1",
     "cs": "ESTABLISHED",
     "ss": "ESTABLISHED"
    },
    {
     "d": "r",
     "t": "data: GET /profile …",
     "c": "purple",
     "s": "the request can finally go"
    }
   ]
  ],
  "close": [
   "Laptop",
   "kade-api",
   [
    {
     "d": "note",
     "t": "both sides ESTABLISHED; the laptop is done",
     "cs": "ESTABLISHED",
     "ss": "ESTABLISHED"
    },
    {
     "d": "r",
     "t": "FIN · \"I have nothing more to send\"",
     "cs": "FIN-WAIT-1"
    },
    {
     "d": "l",
     "t": "ACK",
     "c": "green",
     "cs": "FIN-WAIT-2",
     "ss": "CLOSE-WAIT"
    },
    {
     "d": "l",
     "t": "data can still flow this way (half-close)",
     "c": "purple"
    },
    {
     "d": "l",
     "t": "FIN · \"me too\"",
     "ss": "LAST-ACK"
    },
    {
     "d": "r",
     "t": "ACK",
     "c": "green",
     "cs": "TIME-WAIT",
     "ss": "CLOSED"
    },
    {
     "d": "note",
     "t": "the laptop waits 60 s, then forgets the connection",
     "cs": "CLOSED"
    }
   ]
  ],
